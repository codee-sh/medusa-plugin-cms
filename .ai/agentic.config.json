{
  "version": 1,
  "baseBranch": "develop",
  "tracker": "github",
  "browser": {
    "provider": "agent-browser"
  },
  "validation": {
    "commands": [
      "yarn lint",
      "yarn typecheck",
      "yarn format:check",
      "yarn test:unit"
    ]
  },
  "labels": {
    "enabled": false,
    "pipeline": ["review", "changes-requested", "qa", "qa-failed", "merge-queue", "blocked", "do-not-merge"],
    "category": ["bug", "feature", "refactor", "security", "dependencies", "documentation"],
    "meta": ["needs-qa", "skip-qa", "qa-approved", "qa-self-verified", "in-progress", "ci-monitoring"],
    "priority": ["priority-low", "priority-medium", "priority-high", "priority-extreme"],
    "risk": ["risk-low", "risk-medium", "risk-high"]
  },
  "qaGate": false,
  "ci": {
    "maxWaitMinutes": 0
  },
  "engine": {
    "loopStepThreshold": 20,
    "executorTier": "standard",
    "stepReview": "final"
  },
  "paths": {
    "runs": ".ai/runs",
    "analysis": ".ai/analysis",
    "specs": ".ai/specs",
    "scripts": ".ai/scripts",
    "qa": ".ai/qa"
  },
  "lessons": {
    "path": ".ai/lessons",
    "index": ".ai/lessons.md",
    "modulesFrom": ".ai/specs",
    "areas": ["admin", "backend", "testing", "tooling"],
    "topics": [
      "api-routes",
      "caching",
      "database",
      "dml",
      "files",
      "i18n",
      "media",
      "metadata",
      "middleware",
      "migrations",
      "module-links",
      "orm",
      "testing",
      "tooling",
      "typescript",
      "ui",
      "upgrade",
      "validation",
      "workflows"
    ]
  },
  "reviewChecklist": null,
  "closeKeywords": []
}
